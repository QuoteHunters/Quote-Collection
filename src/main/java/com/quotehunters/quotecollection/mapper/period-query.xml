<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE properties SYSTEM "http://java.sun.com/dtd/properties.dtd">
<!-- Period(시대) 기능에서 사용하는 SQL 모음 파일 -->
<properties>

    <!-- [조회] 전체 시대 목록 조회 (Period-002: 수정/삭제 진입 시 리스트 출력용) -->
    <entry key="selectAllPeriod">
        SELECT period_id, period_name FROM period ORDER BY period_id
    </entry>

    <!-- [조회] 이름으로 시대 조회 (중복 확인용 — 등록/수정 Validation에서 사용) -->
    <entry key="selectPeriodByName">
        SELECT period_id, period_name FROM period WHERE period_name = ?
    </entry>

    <!-- [등록] 새 시대 등록 (Period-001) -->
    <entry key="insertPeriod">
        INSERT INTO period (period_name) VALUES (?)
    </entry>

    <!-- [수정] 시대명 수정 (Period-003) -->
    <entry key="updatePeriod">
        UPDATE period SET period_name = ? WHERE period_id = ?
    </entry>

    <!-- [삭제 1단계] 해당 시대 소속 인물들의 명언에 달린 즐겨찾기 삭제 -->
    <entry key="deleteBookmarkByPeriod">
        DELETE FROM bookmark
        WHERE quote_id IN (
            SELECT quote_id FROM quote
            WHERE person_id IN (
                SELECT person_id FROM person WHERE period_id = ?
            )
        )
    </entry>

    <!-- [삭제 2단계] 해당 시대 소속 인물들의 명언 삭제 -->
    <entry key="deleteQuoteByPeriod">
        DELETE FROM quote
        WHERE person_id IN (
            SELECT person_id FROM person WHERE period_id = ?
        )
    </entry>

    <!-- [삭제 3단계] 해당 시대 소속 인물 삭제 -->
    <entry key="deletePersonByPeriod">
        DELETE FROM person WHERE period_id = ?
    </entry>

    <!-- [삭제 4단계] 시대 삭제 (Period-004 최종 단계) -->
    <entry key="deletePeriod">
        DELETE FROM period WHERE period_id = ?
    </entry>

</properties>
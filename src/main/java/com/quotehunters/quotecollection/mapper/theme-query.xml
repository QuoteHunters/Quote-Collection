<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<!DOCTYPE properties SYSTEM "http://java.sun.com/dtd/properties.dtd">
<properties>
    <entry key="insertTheme">
        INSERT INTO theme (theme_name) VALUES (?)
    </entry>

    <entry key="existsThemeName">
        SELECT COUNT(*) FROM theme WHERE theme_name = ?
    </entry>

    <entry key="existsThemeNameExceptId">
        select COUNT(*) FROM theme WHERE theme_name = ? AND theme_id != ?
    </entry>

    <entry key="selectThemes">
        SELECT * FROM theme ORDER BY theme_id
    </entry>

    <entry key="updateTheme">
        UPDATE theme SET theme_name = ? WHERE theme_id = ?
    </entry>

    <entry key="deleteTheme">
        DELETE FROM theme WHERE theme_id = ?
    </entry>
</properties>
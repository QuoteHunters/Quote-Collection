<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<!DOCTYPE properties SYSTEM "http://java.sun.com/dtd/properties.dtd">
<properties>
    <entry key="allField">
        SELECT * FROM field ORDER BY field_id
    </entry>

    <entry key="searchById">
        SELECT * FROM field WHERE field_id = ?
    </entry>

    <entry key="existsFieldName">
        select COUNT(*) FROM field WHERE field_name = ?
    </entry>

    <entry key="existsFieldNameExceptId">
        select COUNT(*) FROM field WHERE field_name = ? AND field_id != ?
    </entry>

    <entry key="updateField">
        UPDATE field SET field_name = ? WHERE field_id = ?
    </entry>
    
    <entry key="insertField">
        INSERT INTO field (field_name) VALUES (?)
    </entry>

    <entry key="deleteField">
        DELETE FROM field WHERE field_id = ?
    </entry>
</properties>